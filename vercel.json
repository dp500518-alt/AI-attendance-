{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/static/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/static/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "FLASK_ENV": "production",
    "FLASK_DEBUG": "0",
    "DATA_DIR": "/tmp/smart_attendance_data"
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
