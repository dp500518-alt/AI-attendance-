{
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/static/css/(.*)",
      "destination": "/css/$1"
    },
    {
      "source": "/static/js/(.*)",
      "destination": "/js/$1"
    },
    {
      "source": "/static/images/(.*)",
      "destination": "/images/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "env": {
    "FLASK_ENV": "production",
    "FLASK_DEBUG": "0",
    "DATA_DIR": "/tmp/smart_attendance_data"
  }
}
